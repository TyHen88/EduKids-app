# Copy this file to `.env` and fill in real values.
# `.env` (not `.env.local`) is required because drizzle.config.ts and
# scripts/prod.ts load it via `dotenv/config` for the db:* commands.

# ── Database (Neon serverless Postgres) ────────────────────────────────
# Connection string from your Neon project. Used by the app, drizzle-kit,
# and the seed script.
DATABASE_URL=

# ── Clerk authentication ───────────────────────────────────────────────
# From the Clerk dashboard (API Keys). Use pk_live_/sk_live_ in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: override Clerk's default auth routes. This app serves custom
# pages under /[lang]/sign-in and /[lang]/sign-up and already wires these
# via <ClerkProvider> in app/[lang]/layout.tsx — normally not needed.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk user IDs allowed into the admin panel (/[lang]/admin).
# Comma-AND-space separated (the code splits on ", "), e.g. "user_abc, user_def".
CLERK_ADMIN_IDS=

# ── App ────────────────────────────────────────────────────────────────
# Public base URL, used by absoluteUrl() in lib/utils.ts.
# e.g. http://localhost:3000 in development, https://your-domain in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_VAPID_PRIVATE_KEY=
