# Copy this file to `.env` and fill in real values.
# `.env` (not `.env.local`) is required because drizzle.config.ts and
# scripts/prod.ts load it via `dotenv/config` for the db:* commands.

# ── Database (Neon serverless Postgres) ────────────────────────────────
# Connection string from your Neon project. Used by the app, drizzle-kit,
# and the seed script.
DATABASE_URL=

# ── Supabase authentication ────────────────────────────────────────────
# From the Supabase dashboard → Project Settings → API.
# URL + anon key are safe to expose to the browser; the service-role key is
# server-only and bypasses Row Level Security — never expose it client-side.
# See SUPABASE_SETUP.md for the full setup walkthrough.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase auth user UUIDs allowed into the admin panel (/[lang]/admin).
# Comma-AND-space separated (the code splits on ", "), e.g. "uuid-a, uuid-b".
ADMIN_IDS=

# ── App ────────────────────────────────────────────────────────────────
# Public base URL, used by absoluteUrl() in lib/utils.ts.
# e.g. http://localhost:3000 in development, https://your-domain in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_VAPID_PRIVATE_KEY=

# ── Ably (real-time in-app notifications) ──────────────────────────────
# Server-only API key from https://ably.com (App → API Keys). Clients use a
# short-lived token issued by actions/ably.ts, so this never reaches the browser.
ABLY_API_KEY=

# ── Vercel Blob (image uploads) ────────────────────────────────────────
# Read/write token for the Blob store. Create a Blob store in the Vercel
# dashboard (Storage → Blob); it generates this token automatically for
# deployments. Copy it here for local dev (`vercel env pull` also works).
BLOB_READ_WRITE_TOKEN=

# Serper.dev API key for the image search tool (https://serper.dev)
SERPER_API_KEY=
